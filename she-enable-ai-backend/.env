# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas — get this from mongodb.com/atlas after creating a free cluster
MONGO_URI=mongodb+srv://yourUsername:yourPassword@cluster0.xxxxx.mongodb.net/sheenableai?retryWrites=true&w=majority

# JWT — make these long random strings (go to random.org and generate 32+ characters)
JWT_SECRET=make_this_a_very_long_random_string_nobody_can_guess_32chars
JWT_REFRESH_SECRET=another_completely_different_long_random_string_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cloudinary — from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SendGrid — from sendgrid.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@sheenableai.com
FROM_NAME=SheEnableAI

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173